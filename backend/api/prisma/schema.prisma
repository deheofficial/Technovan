// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  SALES
  MANAGER
}

enum QuotationStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
}

enum AuditAction {
  CREATED
  UPDATED
  STATUS_CHANGED
  SUBMITTED_FOR_APPROVAL
  APPROVED
  SENT
  CLIENT_ACCEPTED
  CLIENT_REJECTED
  CONVERTED_TO_PROJECT
  TEMPLATE_APPLIED
}

model User {
  id            String     @id @default(cuid())
  email         String     @unique
  password      String
  fullName      String
  phone         String?
  role          UserRole   @default(SALES)
  isActive      Boolean    @default(true)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  quotations        Quotation[]         @relation("QuotationOwner")
  approvals         QuotationVersion[]  @relation("ApprovedBy")
  createdTemplates  QuotationTemplate[]
  auditLogs         QuotationAuditLog[]
  projects          Project[]           @relation("ProjectOwner")

  @@index([email])
  @@index([role])
}

model Client {
  id             String      @id @default(cuid())
  companyName    String
  contactPerson  String
  email          String
  phone          String
  addressLine1   String?
  addressLine2   String?
  city           String?
  state          String?
  country        String?
  postalCode     String?
  notes          String?     @db.Text
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  quotations     Quotation[]
  projects       Project[]

  @@index([companyName])
  @@index([email])
}

model Quotation {
  id                String               @id @default(cuid())
  quotationNumber   String               @unique
  title             String
  clientId          String
  ownerId           String
  status            QuotationStatus      @default(DRAFT)
  currency          String               @default("MYR")
  expiryDate        DateTime
  discountAmount    Decimal              @default(0) @db.Decimal(12, 2)
  sstRate           Decimal              @default(0.06) @db.Decimal(5, 4)
  internalNotes     String?              @db.Text
  termsAndConditions String?             @db.Text
  versionNumber     Int                  @default(1)
  revisionOfId      String?
  currentVersionId  String?              @unique
  publicToken       String               @unique
  acceptedAt        DateTime?
  rejectedAt        DateTime?
  sentAt            DateTime?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  client            Client               @relation(fields: [clientId], references: [id], onDelete: Cascade)
  owner             User                 @relation("QuotationOwner", fields: [ownerId], references: [id])
  revisionOf        Quotation?           @relation("QuotationRevision", fields: [revisionOfId], references: [id], onDelete: SetNull)
  revisions         Quotation[]          @relation("QuotationRevision")
  currentVersion    QuotationVersion?    @relation("CurrentQuotationVersion", fields: [currentVersionId], references: [id], onDelete: SetNull)
  versions          QuotationVersion[]   @relation("QuotationVersions")
  templates         QuotationTemplate[]
  auditLogs         QuotationAuditLog[]
  project           Project?

  @@index([clientId])
  @@index([ownerId])
  @@index([status])
  @@index([expiryDate])
  @@index([revisionOfId])
}

model QuotationVersion {
  id                 String               @id @default(cuid())
  quotationId        String
  versionLabel       String
  scopeSummary       String?              @db.Text
  subtotal           Decimal              @default(0) @db.Decimal(12, 2)
  discountAmount     Decimal              @default(0) @db.Decimal(12, 2)
  taxAmount          Decimal              @default(0) @db.Decimal(12, 2)
  grandTotal         Decimal              @default(0) @db.Decimal(12, 2)
  approvalRequestedAt DateTime?
  approvedAt         DateTime?
  approvedById       String?
  rejectionReason    String?              @db.Text
  createdAt          DateTime             @default(now())

  quotation          Quotation            @relation("QuotationVersions", fields: [quotationId], references: [id], onDelete: Cascade)
  approvedBy         User?                @relation("ApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  items              QuotationItem[]
  auditLogs          QuotationAuditLog[]
  currentForQuotation Quotation?          @relation("CurrentQuotationVersion")

  @@unique([quotationId, versionLabel])
  @@index([quotationId])
  @@index([approvedById])
}

model QuotationItem {
  id                String            @id @default(cuid())
  quotationVersionId String
  lineOrder         Int               @default(0)
  serviceName       String
  description       String            @db.Text
  quantity          Decimal           @default(1) @db.Decimal(12, 2)
  unitPrice         Decimal           @default(0) @db.Decimal(12, 2)
  lineTotal         Decimal           @default(0) @db.Decimal(12, 2)
  createdAt         DateTime          @default(now())

  quotationVersion  QuotationVersion  @relation(fields: [quotationVersionId], references: [id], onDelete: Cascade)

  @@index([quotationVersionId])
}

model QuotationTemplate {
  id                 String   @id @default(cuid())
  quotationId        String?
  name               String
  description        String?  @db.Text
  defaultDiscount    Decimal  @default(0) @db.Decimal(12, 2)
  defaultSstRate     Decimal  @default(0.06) @db.Decimal(5, 4)
  termsAndConditions String?  @db.Text
  lineItems          Json
  createdById        String
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  quotation          Quotation? @relation(fields: [quotationId], references: [id], onDelete: SetNull)
  createdBy          User       @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@index([createdById])
  @@index([quotationId])
}

model QuotationAuditLog {
  id             String       @id @default(cuid())
  quotationId    String
  quotationVersionId String?
  userId         String?
  action         AuditAction
  message        String
  metadata       Json?
  createdAt      DateTime     @default(now())

  quotation      Quotation    @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  quotationVersion QuotationVersion? @relation(fields: [quotationVersionId], references: [id], onDelete: SetNull)
  user           User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([quotationId])
  @@index([quotationVersionId])
  @@index([userId])
}

model Project {
  id                 String   @id @default(cuid())
  projectCode        String   @unique
  name               String
  clientId           String
  quotationId        String   @unique
  ownerId            String
  scopeSummary       String?  @db.Text
  pricingStructure   Json
  status             String   @default("PLANNING")
  startDate          DateTime?
  endDate            DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  client             Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  quotation          Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  owner              User      @relation("ProjectOwner", fields: [ownerId], references: [id])

  @@index([clientId])
  @@index([ownerId])
}
