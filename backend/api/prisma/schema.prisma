// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  CUSTOMER
  SUPPORT
}

enum ProjectStatus {
  PENDING
  APPROVED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum ChangeRequestStatus {
  DRAFT
  SUBMITTED
  TECHNICAL_ASSESSMENT
  APPROVAL
  IMPLEMENTATION
  UAT_TESTING
  DEPLOYMENT
  CLOSED
  REJECTED
  RETURNED
  UAT_FAILED
}

enum ChangeRequestType {
  CHANGE_REQUEST
  ENHANCEMENT
  BUG_FIX
  NEW_REQUIREMENT
  CONFIGURATION_CHANGE
}

enum ChangeRequestPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ApprovalDecision {
  APPROVED
  REJECTED
  RETURNED
}

enum UATResult {
  PENDING
  PASS
  FAIL
}

model User {
  id            String     @id @default(cuid())
  email         String     @unique
  password      String
  firstName     String
  lastName      String
  phone         String?
  company       String?
  role          UserRole   @default(CUSTOMER)
  avatar        String?
  isActive      Boolean    @default(true)
  emailVerified Boolean    @default(false)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  projects      Project[]
  inquiries     Inquiry[]
  payments      Payment[]
  messages      Message[]
  requestedChangeRequests ChangeRequest[] @relation("ChangeRequestRequester")
  preparedChangeRequests ChangeRequest[] @relation("ChangeRequestPreparer")
  approvedChangeRequests ChangeRequest[] @relation("ChangeRequestApprover")
  assignedChangeRequests  ChangeRequest[] @relation("ChangeRequestAssignee")
  technicalAssessments TechnicalAssessment[]
  changeRequestApprovals ChangeRequestApproval[]
  uatTestCases UATTestCase[]
  changeRequestStatusChanges ChangeRequestStatusHistory[]
  changeRequestAttachments ChangeRequestAttachment[]

  @@index([email])
  @@index([role])
}

model Service {
  id          String   @id @default(cuid())
  title       String
  description String
  icon        String?
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive])
}

model Pricing {
  id          String   @id @default(cuid())
  name        String   @unique
  price       Float
  currency    String   @default("RM")
  description String?
  features    String[]
  isActive    Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  projects Project[]

  @@index([isActive])
}

model Project {
  id          String        @id @default(cuid())
  title       String
  description String
  status      ProjectStatus @default(PENDING)
  pricingId   String
  pricing     Pricing       @relation(fields: [pricingId], references: [id])
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  budget      Float?
  deadline    DateTime?
  files       String[]
  notes       String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  messages Message[]
  payments Payment[]
  changeRequests ChangeRequest[]

  @@index([userId])
  @@index([status])
  @@index([pricingId])
}

model Inquiry {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  message   String
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  isRead    Boolean  @default(false)
  responded Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([isRead])
}

model Quotation {
  id          String   @id @default(cuid())
  name        String
  email       String
  phone       String?
  company     String?
  service     String?
  budget      String?
  timeline    String?
  projectIdea String
  source      String   @default("public-site")
  isRead      Boolean  @default(false)
  responded   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([email])
  @@index([isRead])
  @@index([createdAt])
}

model QuotationTemplate {
  id        String   @id @default(cuid())
  ownerKey  String
  name      String
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerKey])
  @@index([createdAt])
  @@unique([ownerKey, name])
}

model Message {
  id        String   @id @default(cuid())
  content   String
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([projectId])
  @@index([userId])
}

model Payment {
  id              String        @id @default(cuid())
  amount          Float
  currency        String        @default("RM")
  status          PaymentStatus @default(PENDING)
  method          String        // stripe, paypal, bank_transfer
  transactionId   String?       @unique
  projectId       String
  project         Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId          String
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  invoiceUrl      String?
  description     String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([userId])
  @@index([projectId])
  @@index([status])
}

model ChangeRequest {
  id                   String               @id @default(cuid())
  crNumber             String               @unique
  title                String
  description          String
  requestType          ChangeRequestType
  systemModule         String
  priority             ChangeRequestPriority @default(MEDIUM)
  status               ChangeRequestStatus   @default(DRAFT)
  currentBehaviour     String
  proposedChange       String
  businessJustification String
  requesterName        String?
  requesterEmail       String?
  preparedByName       String?
  approvedByName       String?
  requestedById        String
  preparedById         String?
  approvedById         String?
  assignedToId         String?
  projectId            String?
  submittedAt          DateTime?
  closedAt             DateTime?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  requestedBy          User                 @relation("ChangeRequestRequester", fields: [requestedById], references: [id])
  preparedBy           User?                @relation("ChangeRequestPreparer", fields: [preparedById], references: [id], onDelete: SetNull)
  approvedBy           User?                @relation("ChangeRequestApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  assignedTo           User?                @relation("ChangeRequestAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  project              Project?             @relation(fields: [projectId], references: [id], onDelete: SetNull)
  technicalAssessment  TechnicalAssessment?
  approvals            ChangeRequestApproval[]
  implementation       ChangeRequestImplementation?
  uatTestCases         UATTestCase[]
  attachments          ChangeRequestAttachment[]
  statusHistory        ChangeRequestStatusHistory[]

  @@index([requestedById])
  @@index([preparedById])
  @@index([approvedById])
  @@index([assignedToId])
  @@index([projectId])
  @@index([status])
  @@index([createdAt])
}

model TechnicalAssessment {
  id                   String        @id @default(cuid())
  changeRequestId      String        @unique
  assessedById         String
  technicalImpact      String
  databaseApiUiImpact  String
  estimatedEffort      String
  risk                 String
  dependencies         String
  proposedSolution     String
  recommendation       String
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  changeRequest        ChangeRequest @relation(fields: [changeRequestId], references: [id], onDelete: Cascade)
  assessedBy           User          @relation(fields: [assessedById], references: [id])
  @@index([assessedById])
}

model ChangeRequestApproval {
  id                String          @id @default(cuid())
  changeRequestId   String
  approverId        String
  decision          ApprovalDecision
  comments          String?
  approvalDate      DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  changeRequest     ChangeRequest   @relation(fields: [changeRequestId], references: [id], onDelete: Cascade)
  approver          User            @relation(fields: [approverId], references: [id])
  @@unique([changeRequestId, approverId])
  @@index([approverId])
}

model ChangeRequestImplementation {
  id                    String        @id @default(cuid())
  changeRequestId       String        @unique
  assignedDeveloperTeam String
  implementationDetails String
  developmentStatus     String
  version               String?
  deploymentDetails    String?
  rollbackPlan          String
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  changeRequest         ChangeRequest @relation(fields: [changeRequestId], references: [id], onDelete: Cascade)
}

model UATTestCase {
  id              String        @id @default(cuid())
  changeRequestId String
  testerId        String
  testScenario    String
  expectedResult  String
  actualResult    String?
  result          UATResult     @default(PENDING)
  uatApproval     Boolean       @default(false)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  changeRequest   ChangeRequest @relation(fields: [changeRequestId], references: [id], onDelete: Cascade)
  tester          User          @relation(fields: [testerId], references: [id])
  @@index([testerId])
}

model ChangeRequestStatusHistory {
  id              String              @id @default(cuid())
  changeRequestId String
  fromStatus      ChangeRequestStatus?
  toStatus        ChangeRequestStatus
  changedById     String
  comments        String?
  createdAt       DateTime            @default(now())

  changeRequest   ChangeRequest       @relation(fields: [changeRequestId], references: [id], onDelete: Cascade)
  changedBy       User                @relation(fields: [changedById], references: [id])
  @@index([changeRequestId])
  @@index([changedById])
}

model ChangeRequestAttachment {
  id              String        @id @default(cuid())
  changeRequestId String
  uploadedById    String
  fileName        String
  fileUrl         String
  fileType        String?
  fileSize        Int?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  changeRequest   ChangeRequest @relation(fields: [changeRequestId], references: [id], onDelete: Cascade)
  uploadedBy      User          @relation(fields: [uploadedById], references: [id])
  @@index([uploadedById])
}

model Portfolio {
  id          String   @id @default(cuid())
  title       String
  description String
  image       String?
  link        String?
  category    String
  isActive    Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive])
  @@index([category])
}

model BlogPost {
  id        String   @id @default(cuid())
  title     String
  content   String
  excerpt   String?
  image     String?
  slug      String   @unique
  published Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published])
  @@index([slug])
}

model Analytics {
  id           String   @id @default(cuid())
  pageView     Int      @default(0)
  uniqueUsers  Int      @default(0)
  totalRevenue Float    @default(0)
  date         DateTime @default(now())
  createdAt    DateTime @default(now())

  @@index([date])
}
